{
  "version": 2,
  "framework": null,
  "buildCommand": "pnpm install && BASE_PATH=/ pnpm --filter @workspace/zettapoint run build",
  "outputDirectory": "artifacts/zettapoint/dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/reset-rooms",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
